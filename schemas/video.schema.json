{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GL-Kageyama/semantic-guide-loom/schemas/video.schema.json",
  "title": "video.yaml — 映像の台本",
  "description": "作品が持つ映像側の台本。音には渡らない。export_timeline.py が読み、timeline.json へ写す。",
  "type": "object",
  "required": ["title", "template"],
  "additionalProperties": true,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "channel": {"type": "string"},
    "template": {
      "type": "string",
      "minLength": 1,
      "description": "references/templates/<name>/template.yaml の名"
    },
    "cast": {
      "type": "string",
      "description": "characters/<name>.cast.yaml の名。人物を置かない型は書かない"
    },
    "width": {"type": "integer", "minimum": 16},
    "height": {"type": "integer", "minimum": 16},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "chapters": {
      "type": "object",
      "description": "cue の名 → 章。label と title 以外の欄は型が決める（素通しする）。",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
      "additionalProperties": {"$ref": "#/$defs/chapter"}
    },
    "display": {
      "type": "object",
      "description": "cue の名 → 字幕の文（原表記）。無い cue は script.yaml の line がそのまま出る。",
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]+$"},
      "additionalProperties": {"type": "string"}
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": ["label", "title"],
      "additionalProperties": true,
      "properties": {
        "label": {"type": "string", "description": "章の名（序章・第1章 など）"},
        "title": {"type": "string", "description": "章の題"},
        "term": {"type": "string", "description": "dialogue-bust が読む語"},
        "key": {"type": "string", "description": "dialogue-bust が読む一行（改行可）"},
        "details": {
          "type": "array",
          "description": "章の中で切り替わる詳細カード。cue の頭で切り替わる。",
          "items": {"$ref": "#/$defs/detail"}
        },
        "bullets": {
          "type": "array",
          "items": {"type": "string"},
          "description": "narrate-slide が読む箇条書き"
        }
      }
    },
    "detail": {
      "type": "object",
      "required": ["cue", "head", "lines"],
      "additionalProperties": true,
      "properties": {
        "cue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "このカードに切り替わる章内の cue"
        },
        "head": {"type": "string", "minLength": 1, "description": "見出し（1 行）"},
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1},
          "description": "検証済みの事実。各項目は 1 表示行に割る"
        },
        "fact": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "research/facts.yaml の id"
        }
      }
    }
  }
}
