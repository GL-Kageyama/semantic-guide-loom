{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GL-Kageyama/semantic-guide-loom/schemas/research.schema.json",
  "title": "research — 調査の台帳",
  "description": "projects/<作品>/research/sources.yaml と facts.yaml の形。出典と、映像で言ってよい事実。",
  "type": "object",
  "additionalProperties": true,
  "oneOf": [
    {
      "required": ["sources"],
      "properties": {
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    {
      "required": ["facts"],
      "properties": {
        "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}}
      }
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "title", "kind", "accessed"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "kind": {"enum": ["official", "paper", "reference", "news", "in-work"]},
        "url": {"type": "string", "pattern": "^https?://"},
        "path": {"type": "string", "minLength": 1},
        "accessed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "confidence": {"enum": ["high", "medium", "low"]},
        "note": {"type": "string"}
      },
      "anyOf": [{"required": ["url"]}, {"required": ["path"]}]
    },
    "fact": {
      "type": "object",
      "required": ["id", "statement", "sources", "confidence"],
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "statement": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "confidence": {"enum": ["high", "medium", "low"]},
        "used_by": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}
      }
    }
  }
}
